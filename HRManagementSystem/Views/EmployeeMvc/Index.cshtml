@{
}
@model List<HRManagementSystem.Models.Employee>
<a href="/EmployeeMvc/Create">Add New Employee</a>
<br />
<br />

<h2>Employee List</h2>
<table class="table table-bordered">
    <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Salary</th>
        <th>Action</th>
    </tr>

    @foreach (var emp in Model)
    {
        <tr>
            <td>@emp.Name</td>
            <td>@emp.Email</td>
            <td>@emp.Role</td>
            <td>@emp.Salary</td>
            <td>
                <a href="/EmployeeMvc/Edit/@emp.Id">Edit</a>
            </td>
            <td>
                <a href="/EmployeeMvc/Delete/@emp.Id">Delete</a>
            </td>
        </tr>
    }
</table>
